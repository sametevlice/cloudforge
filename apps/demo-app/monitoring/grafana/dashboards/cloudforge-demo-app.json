{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application Status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"cloudforge-demo-app\"}", "legendFormat": "Application", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"cloudforge-demo-app\"}[1m]))", "legendFormat": "{{method}} {{uri}} - {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 18, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM Heap Memory",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (id) (jvm_memory_used_bytes{application=\"cloudforge-demo-app\",area=\"heap\"})", "legendFormat": "{{id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average Response Time",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{application=\"cloudforge-demo-app\"}[1m])) / clamp_min(sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"cloudforge-demo-app\"}[1m])), 0.000001)", "legendFormat": "{{method}} {{uri}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["cloudforge", "spring-boot", "prometheus"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "CloudForge Demo Application",
  "uid": "cloudforge-demo-app",
  "version": 1
}
